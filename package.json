{
  "name": "our-civic-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Open, source-backed civic atlas infrastructure with Flint as the first city node.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:civic-editor && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:atlas": "node scripts/validate-static-atlas.mjs && node scripts/validate-visual-grammar.mjs && node scripts/validate-dossier-payload.mjs --fail-on-warning",
    "validate:reconstruction-node-tree": "node --experimental-strip-types scripts/validate-reconstruction-node-tree.mjs",
    "validate:scene-manifest": "node scripts/validate-static-atlas.mjs --target=scene-manifest",
    "validate:scenario-manifest": "node scripts/validate-static-atlas.mjs --target=scenario-manifest",
    "validate:primitive-library": "node scripts/validate-static-atlas.mjs --target=primitive-library",
    "validate:geo-comments": "node scripts/validate-static-atlas.mjs --target=geo-comments",
    "validate:layer-recipes": "node scripts/validate-static-atlas.mjs --target=layer-recipes",
    "validate:visual-grammar": "node scripts/validate-visual-grammar.mjs",
    "validate:dossier": "node scripts/validate-dossier-payload.mjs --fail-on-warning",
    "validate:dossier:live": "node scripts/validate-dossier-payload.mjs --fail-on-warning --base-url http://localhost:3000",
    "validate:traffic": "node scripts/validate-traffic-realtime.mjs --fail-on-warning",
    "validate:traffic:live": "node scripts/validate-traffic-realtime.mjs --fail-on-warning --base-url http://localhost:3000",
    "validate:analytical-workbench": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-analytical-workbench.mjs",
    "validate:layer-contract": "node scripts/validate-layer-contract.mjs",
    "validate:routes:live": "node scripts/smoke-open-flint-routes.mjs",
    "validate:time-travel": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-atlas-time-travel.mjs",
    "validate:urban-model": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-urban-design-model.mjs",
    "atlas:starter": "node scripts/generate-atlas-starter.mjs",
    "atlas:geocode-index": "node scripts/build-geocode-index.mjs",
    "weather:fetch": "node scripts/fetch-gfs-weather.mjs",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "porchfest:import-kml": "node scripts/kml-to-event-layer.mjs",
    "validate:civic-store": "esbuild scripts/validate-civic-store.ts --bundle --platform=node --format=esm --tsconfig=scripts/tsconfig.civic-validate.json --outfile=node_modules/.cache/validate-civic-store.mjs --log-level=warning && node node_modules/.cache/validate-civic-store.mjs",
    "validate:civic-apply-bridge": "esbuild scripts/validate-civic-apply-bridge.ts --bundle --platform=node --format=esm --tsconfig=scripts/tsconfig.civic-validate.json --outfile=node_modules/.cache/validate-civic-apply-bridge.mjs --log-level=warning && node node_modules/.cache/validate-civic-apply-bridge.mjs",
    "validate:civic-ledger-ingest": "esbuild scripts/validate-civic-ledger-ingest.ts --bundle --platform=node --format=esm --tsconfig=scripts/tsconfig.civic-validate.json --outfile=node_modules/.cache/validate-civic-ledger-ingest.mjs --log-level=warning && node node_modules/.cache/validate-civic-ledger-ingest.mjs",
    "validate:civic-map-binding": "esbuild scripts/validate-civic-map-binding.ts --bundle --platform=node --format=esm --tsconfig=scripts/tsconfig.civic-validate.json --outfile=node_modules/.cache/validate-civic-map-binding.mjs --log-level=warning && node node_modules/.cache/validate-civic-map-binding.mjs",
    "validate:civic-address-sync": "esbuild scripts/validate-civic-address-sync.ts --bundle --platform=node --format=esm --tsconfig=scripts/tsconfig.civic-validate.json --outfile=node_modules/.cache/validate-civic-address-sync.mjs --log-level=warning && node node_modules/.cache/validate-civic-address-sync.mjs",
    "validate:formspree-import": "esbuild scripts/validate-formspree-import.ts --bundle --platform=node --format=esm --tsconfig=scripts/tsconfig.civic-validate.json --outfile=node_modules/.cache/validate-formspree-import.mjs --log-level=warning && node node_modules/.cache/validate-formspree-import.mjs",
    "validate:figure-resolver": "esbuild scripts/validate-figure-resolver.ts --bundle --platform=node --format=esm --tsconfig=scripts/tsconfig.civic-validate.json --outfile=node_modules/.cache/validate-figure-resolver.mjs --log-level=warning && node node_modules/.cache/validate-figure-resolver.mjs",
    "validate:figure-library": "esbuild scripts/validate-figure-library.ts --bundle --platform=node --format=esm --tsconfig=scripts/tsconfig.civic-validate.json --outfile=node_modules/.cache/validate-figure-library.mjs --log-level=warning && node node_modules/.cache/validate-figure-library.mjs",
    "validate:planner-import": "esbuild scripts/validate-planner-import.ts --bundle --platform=node --format=esm --tsconfig=scripts/tsconfig.civic-validate.json --outfile=node_modules/.cache/validate-planner-import.mjs --log-level=warning && node node_modules/.cache/validate-planner-import.mjs",
    "validate:porchfest-domain-routing": "node scripts/validate-porchfest-domain-routing.mjs",
    "porchfest:import-formspree": "tsx scripts/import-formspree-applications.ts",
    "build:civic-editor": "node scripts/build-civic-editor.mjs",
    "validate:yjs-sync": "node scripts/validate-yjs-sync.mjs"
  },
  "dependencies": {
    "@blocksuite/affine": "^0.22.4",
    "@blocksuite/data-view": "^0.22.4",
    "@blocksuite/integration-test": "^0.22.4",
    "@cosmos.gl/graph": "^2.6.4",
    "@deck.gl-community/editable-layers": "^9.2.1",
    "@deck.gl/core": "^9.3.2",
    "@deck.gl/extensions": "^9.3.2",
    "@deck.gl/layers": "^9.3.2",
    "@deck.gl/mapbox": "^9.3.2",
    "@deck.gl/mesh-layers": "^9.3.2",
    "@duckdb/duckdb-wasm": "^1.32.0",
    "@flowmap.gl/layers": "^9.3.0",
    "@loaders.gl/gltf": "^4.4.2",
    "@observablehq/plot": "^0.6.17",
    "@protomaps/basemaps": "^5.7.2",
    "@react-sigma/core": "^5.0.6",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@thatopen/components": "^3.4.6",
    "@thatopen/fragments": "^3.4.5",
    "@tiptap/extension-highlight": "^3.26.0",
    "@tiptap/extension-placeholder": "^3.26.0",
    "@tiptap/extension-task-item": "^3.26.0",
    "@tiptap/extension-task-list": "^3.26.0",
    "@tiptap/extension-typography": "^3.26.0",
    "@tiptap/markdown": "^3.26.0",
    "@tiptap/pm": "^3.26.0",
    "@tiptap/react": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "@turf/buffer": "^7.3.5",
    "@turf/difference": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "@urql/next": "^2.0.0",
    "@uwdata/vgplot": "^0.15.0",
    "animejs": "^4.4.1",
    "antd": "^5.29.3",
    "brush": "github:ArthurBrussee/brush",
    "camera-controls": "^3.1.2",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "geotiff": "^3.0.5",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphql": "^16.14.0",
    "lucide-react": "^1.14.0",
    "maplibre-gl": "^4.7.1",
    "next": "^16.1.6",
    "pmtiles": "^4.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-map-gl": "^7.1.9",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "urql": "^5.0.2",
    "weatherlayers-gl": "^2026.5.2",
    "web-ifc": "^0.0.77",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.0.0",
    "@graphql-codegen/client-preset": "^6.0.0",
    "@graphql-codegen/typescript": "^6.0.1",
    "@graphql-codegen/typescript-operations": "^6.0.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.13.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@types/xml2js": "^0.4.14",
    "@vanilla-extract/esbuild-plugin": "^2.3.22",
    "adm-zip": "^0.5.16",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.1.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3",
    "xml2js": "^0.6.2"
  }
}
